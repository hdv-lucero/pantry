# Development image for Pantry.
#
# Deliberately NOT the production Dockerfile that `rails new` generates — that
# one belongs to Kamal (M3). This image bakes no application code and runs no
# bundle install: the bind-mounted working tree is the source of truth, and gems
# live in the bundle_cache volume. That is also what lets this image generate the
# app in the first place, before a Gemfile exists.
FROM ruby:3.4-slim

ENV LANG=C.UTF-8 \
    BUNDLE_PATH=/usr/local/bundle

# No Node: importmap + Propshaft + the tailwindcss-rails standalone binary need none.
# Chromium and its driver are here for Capybara system tests (§8) — the container
# is the only place Ruby exists, so it has to be the place the browser exists too.
# Debian's chromium-driver is pinned by the same package set as the browser, which
# is why Selenium Manager is bypassed via CHROMEDRIVER_PATH below rather than left
# to download a driver for a Chrome that isn't installed.
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential \
      chromium \
      chromium-driver \
      curl \
      git \
      libyaml-dev \
      pkg-config \
      sqlite3 && \
    rm -rf /var/lib/apt/lists/*

ENV CHROME_BINARY=/usr/bin/chromium \
    CHROMEDRIVER_PATH=/usr/bin/chromedriver

# uid/gid 1000 matches the host user, so files written into the bind mount come
# out owned by the host user rather than root. Chowning the bundle path before
# the named volume is created means the volume inherits that ownership too.
RUN groupadd --gid 1000 rails && \
    useradd --uid 1000 --gid 1000 --create-home rails && \
    mkdir -p /rails "$BUNDLE_PATH" && \
    chown -R rails:rails /rails "$BUNDLE_PATH"

USER rails
WORKDIR /rails

RUN gem install "rails:~> 8.0" foreman --no-document

EXPOSE 3000

CMD ["bin/dev"]
