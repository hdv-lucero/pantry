<%# §4.1 — "each group a Turbo Frame". Rows nest their own frames inside, so an
    Edit link swaps only its row while the group frame stays available as a target
    for whole-group refreshes. %>
<%= turbo_frame_tag location_frame_id(location), class: "block rounded-xl border border-gray-200 bg-white p-4 shadow-sm" do %>
  <h2 class="text-lg font-semibold text-gray-900"><%= location.capitalize %></h2>

  <%= render "quick_add", pantry_item: PantryItem.new(location: location) %>

  <div id="<%= location_items_id(location) %>" class="mt-3 divide-y divide-gray-100">
    <%# Hidden the moment a Turbo Stream appends a sibling — no JavaScript needed. %>
    <p class="hidden only:block py-2 text-sm text-gray-400">Nothing here yet.</p>
    <%= render partial: "pantry_item", collection: items %>
  </div>
<% end %>
