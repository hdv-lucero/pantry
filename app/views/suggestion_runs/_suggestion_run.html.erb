<%# §4.2 — the run card, through its four states: queued spinner → running →
    completed cards sorted by fewest missing items → failed with a retry button.

    This partial is what `SuggestionRun#broadcast_card` re-renders on every status
    transition, so it is rendered from a broadcast as often as from a request. That
    is why `history` is fetched with a default: a broadcast can only pass the record,
    and the history page is the one caller that wants more than the record implies. %>
<% history = local_assigns.fetch(:history, false) %>
<% suggestions = history ? suggestion_run.recipe_suggestions : suggestion_run.visible_suggestions %>

<%= tag.div id: dom_id(suggestion_run), class: "rounded-xl border border-gray-200 bg-white p-4 shadow-sm" do %>
  <header class="flex flex-wrap items-baseline justify-between gap-2">
    <div class="flex flex-wrap items-center gap-2">
      <%# §4.3 — "any run containing one gets a 'includes one of your favorites ★'
          badge — a cheap join now that identity is normalized." %>
      <% if suggestion_run.includes_favorite? %>
        <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800">
          ★ includes one of your favorites
        </span>
      <% end %>

      <% if suggestion_run.archived? %>
        <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">Archived</span>
      <% end %>

      <% if suggestion_run.prompt_notes.present? %>
        <p class="text-xs text-gray-500">You asked for &ldquo;<%= suggestion_run.prompt_notes %>&rdquo;</p>
      <% end %>
    </div>

    <p class="text-xs text-gray-400"><%= run_timestamp(suggestion_run) %></p>
  </header>

  <% case suggestion_run.status.to_sym %>
  <% when :queued, :running %>
    <p class="mt-3 flex items-center gap-2 text-sm text-gray-500" role="status">
      <span class="size-4 shrink-0 animate-spin rounded-full border-2 border-gray-200 border-t-blue-600" aria-hidden="true"></span>
      <%= suggestion_run.queued? ? "Queued…" : "Searching the web for recipes you can make…" %>
    </p>

  <% when :completed %>
    <% if suggestions.any? %>
      <p class="mt-3 text-sm font-medium text-gray-900">
        <%= pluralize(suggestions.size, "recipe") %> for what you have
      </p>

      <%# §5's ranking — "suggestions sort by fewest missing items by default", which
          the job baked into `position` at parse time. The view just keeps the order. %>
      <ul class="mt-2 space-y-3">
        <% suggestions.each do |recipe_suggestion| %>
          <li>
            <%= render "suggestion_runs/recipe_suggestion", recipe_suggestion: recipe_suggestion, history: history %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3 text-sm text-gray-500">Nothing came back that uses what's in your pantry.</p>
    <% end %>

  <% when :failed %>
    <p class="mt-3 text-sm text-red-700" role="alert">
      <%= suggestion_run.error_message.presence || "Something went wrong." %>
    </p>

    <%# §4.2 step 4's retry button. A new run rather than a rewind of this one — see
        SuggestionRunsController — carrying the note the failed attempt was asked with,
        so retrying does not silently drop "no dairy". %>
    <% unless history %>
      <%= button_to "Try again", suggestion_runs_path,
            params: { suggestion_run: { prompt_notes: suggestion_run.prompt_notes }, retry_of: suggestion_run.id },
            form_class: "mt-2",
            class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 cursor-pointer" %>
    <% end %>
  <% end %>
<% end %>
